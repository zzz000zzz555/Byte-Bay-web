# Byte Bay · plantilla de variables de entorno
#Este archivo SÍ se versiona y es público: NUNCA pongas valores reales aquí.
#Copia este archivo a .env para trabajar en local. .env está ignorado por Git.

# ---------------------------------------------------------------------------
# 1) SECRETOS DE SERVIDOR
# Se guardan en el vault de Supabase, no en el navegador ni en este repo:
#   supabase secrets set GEMINI_API_KEY="valor_real"
#   supabase secrets set MP_ACCESS_TOKEN="valor_real"
#   supabase secrets set MP_WEBHOOK_SECRET="valor_real"
# Supabase inyecta automáticamente SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=PEGA_AQUI
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

MP_ACCESS_TOKEN=PEGA_AQUI
MP_WEBHOOK_SECRET=PEGA_AQUI

CULQI_PUBLIC_KEY=PEGA_AQUI
CULQI_PRIVATE_KEY=PEGA_AQUI
CULQI_WEBHOOK_SECRET=PEGA_AQUI
CULQI_HABILITADO=false

SITE_URL=https://zzz000zzz555.github.io/Byte-Bay-web
ALLOWED_ORIGINS=https://zzz000zzz555.github.io,http://localhost:5500

# ---------------------------------------------------------------------------
# 2) CLAVES PÚBLICAS DEL NAVEGADOR (NO SON SECRETOS)
# GitHub Pages es estático: no puede ocultar lo que descarga el cliente.
# Estos valores aparecen en app.js y demás JS. Su protección real es:
#   - Supabase: RLS + policies + roles, nunca la publishable key.
#   - EmailJS: allowlist de dominios y cuota configuradas en su panel.
# ---------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://inwugycvtaaceugvtfpv.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXX
PUBLIC_EMAILJS_PUBLIC_KEY=PEGA_AQUI
PUBLIC_EMAILJS_SERVICE_ID=PEGA_AQUI
PUBLIC_EMAILJS_TEMPLATE_ID=PEGA_AQUI
PUBLIC_EMAILJS_VERIFICATION_TEMPLATE_ID=PEGA_AQUI

# ---------------------------------------------------------------------------
# Rotación: cambia el valor en el proveedor y luego:
#   supabase secrets set NOMBRE="nuevo_valor"
# Si la llave se filtró, revócala en el proveedor antes de generar otra.
# ---------------------------------------------------------------------------
